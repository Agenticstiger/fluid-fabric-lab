"""fluid-fabric-lab launcher. Run `./lab --help`.

Standard library only (Python 3.10+). The code lives in the `labctl` package
next to this file; the script's own directory is first on sys.path, so no
path manipulation is needed.
"""

import sys

if sys.version_info < (3, 10):
    sys.stderr.write(
        "lab: Python 3.10 or newer is required (found %d.%d)\n" % sys.version_info[:2]
    )
    sys.exit(2)

sys.dont_write_bytecode = True  # keep the checkout free of __pycache__

from labctl.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
