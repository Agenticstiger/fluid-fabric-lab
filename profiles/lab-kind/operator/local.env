#
# The operator's allowlists for products/events-pipeline in the lab (--env local), read by `lab accept`
# for profile lab-kind.
# fluid-host and `lab accept` export them; a contract cannot list itself.
FLUID_ACQUISITION_DEPLOYMENT_HOST_ALLOWLIST=lab-kafka-kafka-bootstrap.kafka.svc
FLUID_SPARK_CONTRACT_SQL_ALLOWLIST=lab.events-pipeline/daily-curated@sha256:66e296094fad5f6d1574059cc0b9e6211bf2c0a6ca577a3d6b231af559864373
# Stage 8 (`fluid policy-apply` onto Lakekeeper) may change grants only in these namespaces,
# <warehouse>/<namespace> in whole dotted levels; unset allows none. They are the local exposes'.
FLUID_LAKEKEEPER_NAMESPACE_ALLOWLIST=sales-wh/events_raw,sales-wh/events_curated,sales-wh/events_marts
