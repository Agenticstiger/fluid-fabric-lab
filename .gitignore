#
# Python bytecode from local test runs. The gates set dont_write_bytecode, but
# `python3 -I` ignores PYTHONDONTWRITEBYTECODE, so a local run can still write
# it; ignored here so `reuse lint` and the gates see only real files.
__pycache__/
*.py[cod]
