#
# The operator's allowlists for products/stream-batch in the lab (--env local).
# `lab check --tier e2e` exports them into each forge command it runs in
# fluid-host; a contract cannot list itself (forge reads them from the operator's
# environment only, never from a project .env).
FLUID_ACQUISITION_DEPLOYMENT_HOST_ALLOWLIST=lab-kafka-kafka-bootstrap.kafka.svc
FLUID_SPARK_CONTRACT_SQL_ALLOWLIST=lab.stream-batch/daily-counts@sha256:f313f5dbb449b966ef338cc4b00e6361422c0a7d0a882f0e77f5a1435e025d03
FLUID_SPARK_LOCAL_NAMESPACE_ALLOWLIST=sales-wh/e2e_raw,sales-wh/e2e_curated
