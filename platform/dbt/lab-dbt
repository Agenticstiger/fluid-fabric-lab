"""lab-dbt: run `dbt` as the lab's pipeline identity (forge's DBT_EXECUTABLE).

Fetches a client-credentials token for Keycloak client `fluid-pipeline`
(scope `trino`, so the token carries aud: trino), puts it in DBT_ENV_SECRET_FLUID_TRINO_JWT
for the child only, and execs `dbt` with the same arguments (dbt scrubs
DBT_ENV_SECRET_* variables from its logs). profiles.yml
(beside this file in ConfigMap lab-dbt) reads DBT_ENV_SECRET_FLUID_TRINO_JWT with
env_var(), and dbt-trino sends it as the JWT.

Environment (Secret fluid-pipeline-client supplies the first two; the secret
is read from the environment, never from argv, and never printed):
  FLUID_CLIENT_ID, FLUID_CLIENT_SECRET   the client's credentials
  LAB_TOKEN_URL     default https://keycloak.lab.test/realms/fluid/protocol/openid-connect/token
  LAB_CA_FILE       default /etc/lab-ca/ca.crt (the lab CA; there is no skip-verify)
  LAB_DBT_SCOPE     default trino
  LAB_DBT_BIN       default dbt
  DBT_PROFILES_DIR  default: the directory of this file

Standard library only.
"""

import json
import os
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request

TOKEN_URL = "https://keycloak.lab.test/realms/fluid/protocol/openid-connect/token"
CA_FILE = "/etc/lab-ca/ca.crt"


class TokenError(Exception):
    pass


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect would carry the client secret to a host nobody chose."""

    def redirect_request(self, *_args, **_kw):
        return None


def fetch_token(env, opener=None):
    client = env.get("FLUID_CLIENT_ID", "")
    secret = env.get("FLUID_CLIENT_SECRET", "")
    if not client or not secret:
        raise TokenError("FLUID_CLIENT_ID and FLUID_CLIENT_SECRET must be set (Secret fluid-pipeline-client)")
    form = urllib.parse.urlencode({
        "grant_type": "client_credentials", "client_id": client, "client_secret": secret,
        "scope": env.get("LAB_DBT_SCOPE", "trino"),
    }).encode()
    url = env.get("LAB_TOKEN_URL", TOKEN_URL)
    if urllib.parse.urlsplit(url).scheme != "https":
        raise TokenError("LAB_TOKEN_URL must be an https URL: the client secret is sent to it")
    request = urllib.request.Request(url, data=form, method="POST",
                                     headers={"Content-Type": "application/x-www-form-urlencoded",
                                              "Accept": "application/json"})
    if opener is None:
        context = ssl.create_default_context(cafile=env.get("LAB_CA_FILE", CA_FILE))
        opener = urllib.request.build_opener(_NoRedirect, urllib.request.HTTPSHandler(context=context))
    try:
        with opener.open(request, timeout=30) as resp:
            body = json.loads(resp.read() or b"null")
    except urllib.error.HTTPError as exc:
        # Keycloak's error code only: the body of a failure never holds the secret, but there is no need to echo it.
        try:
            code = json.loads(exc.read() or b"null").get("error", "")
        except (ValueError, AttributeError):
            code = ""
        raise TokenError(f"Keycloak refused the token request: HTTP {exc.code} {code}".rstrip()) from None
    except (OSError, ValueError) as exc:
        raise TokenError(f"could not get a token from Keycloak: {type(exc).__name__}") from None
    token = body.get("access_token") if isinstance(body, dict) else None
    if not token:
        raise TokenError("Keycloak answered without an access_token")
    return token


def child_env(env, token):
    out = dict(env)
    out["DBT_ENV_SECRET_FLUID_TRINO_JWT"] = token
    out.pop("FLUID_CLIENT_SECRET", None)   # dbt does not need it
    out.setdefault("DBT_PROFILES_DIR", os.path.dirname(os.path.abspath(__file__)))
    return out


def main(argv, env, execvpe=os.execvpe, fetch=fetch_token):
    try:
        token = fetch(env)
    except TokenError as exc:
        print(f"lab-dbt: {exc}", file=sys.stderr)
        return 1
    dbt = env.get("LAB_DBT_BIN", "dbt")
    execvpe(dbt, [dbt] + list(argv), child_env(env, token))
    return 0   # not reached: exec replaces the process


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], os.environ))
