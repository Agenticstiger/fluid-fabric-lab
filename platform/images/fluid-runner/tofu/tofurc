#
# OpenTofu CLI config of the fluid-runner image (TF_CLI_CONFIG_FILE). The
# baked filesystem mirror is the ONLY installation source: there is no
# `direct` block, so a provider that is not in the mirror fails to install
# instead of being downloaded.
provider_installation {
  filesystem_mirror {
    path = "/opt/fluid-runner/providers"
  }
}
