#
# Send the daemon only the build inputs, so a local tofu/.terraform or any
# stray file never reaches the build.
*
!Dockerfile
!requirements.txt
!tofu/providers.tf
!tofu/tofurc
!tofu/.terraform.lock.hcl
!requirements-build.txt
!record_forge.py
