#
# PLANTED: a Helmfile that pulls a chart from the Ilum chart repository.
# The denylist gate's text scan must FAIL.
repositories:
  - name: vendor
    url: https://charts.ilum.cloud
releases:
  - name: spark
    chart: vendor/ilum
